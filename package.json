{
  "name": "rh-management-system",
  "version": "1.0.0",
  "description": "Sistema de Gestión de Recursos Humanos con biométricos",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [
      "dist/client/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --watch src/server -e ts,json --exec ts-node --project tsconfig.server.json src/server/index.ts",
    "client:dev": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/index.js",
    "db:migrate": "ts-node --project tsconfig.server.json src/server/database/migrate.ts"
  },
  "keywords": [
    "HR",
    "biometrics",
    "attendance",
    "permissions"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^2.1.0",
    "@vladmandic/face-api": "^1.7.15",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.10.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
