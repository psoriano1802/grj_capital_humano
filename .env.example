# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=rh_management
DB_USER=postgres
DB_PASSWORD=12345

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Biometric Configuration
BIOMETRIC_TIMEOUT=30000
FACE_ID_ENABLED=true
FINGERPRINT_ENABLED=true

# Face Recognition: motor intercambiable
# descriptor -> matching local en BD (descriptor desde navegador, sin infraestructura)
# compreface -> matching en CompreFace (Docker)
FACE_RECOGNITION_ENGINE=descriptor
FACE_DISTANCE_THRESHOLD=0.5

# CompreFace Configuration (solo si FACE_RECOGNITION_ENGINE=compreface)
COMPREFACE_URL=http://localhost:8000
COMPREFACE_API_KEY=your_compreface_app_api_key
COMPREFACE_SIMILARITY_THRESHOLD=0.7
